# Server Port (e.g. 5000 locally, provided automatically on Render/Railway)
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/collaborative-study-room?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/collaborative-study-room

# JWT signing secret for auth tokens (use a strong random string in production)
JWT_SECRET=supersecret_study_room_jwt_key_2026

# Allowed Frontend Client Origin(s) for CORS and Socket.io
# In production, can be a comma-separated list of origins:
# CLIENT_URL=https://collaborative-study-room.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# Anthropic Claude API Key for AI Notes Summarization & Flashcard Generation
# Never commit your actual key to git! Get an API key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
